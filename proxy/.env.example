# Copy to .env.local for `vercel dev`, and set the same names in the Vercel
# project's Environment Variables UI for Preview + Production.
#
# POSTBASE_SERVICE_KEY must never appear anywhere in the PAUSE static app.

POSTBASE_SERVICE_KEY=
POSTBASE_PROJECT_ID=04a46c89-2217-4449-ae7f-57a4c479b988
POSTBASE_URL=https://db.clinoble.com

# Audience checked on every Google ID token. Without it a token minted for any
# other Google app could be replayed at the proxy.
GOOGLE_CLIENT_ID=857927388938-3rn4ejm805kukp10cerh4f7oakseejgn.apps.googleusercontent.com

# Optional: pin the /token payload shape once known (idToken|id_token|token|
# credential|grantType). Unpinned, the proxy negotiates and logs the winner.
# POSTBASE_GOOGLE_GRANT=

# Password sign-in is disabled for this project. Only set this if it is ever
# enabled upstream.
# POSTBASE_PASSWORD_AUTH_ENABLED=true

# Comma-separated. No wildcard is supported by the code.
ALLOWED_ORIGIN=https://pause.jaideeprao.com
